-- =====================================================
-- THE PLUG MARKETPLACE V1
-- Additive database migration
-- Existing property system remains untouched.
-- =====================================================

-- 1. ADMIN VERIFICATION
-- Uses the existing admin_users.user_id column.

create or replace function public.is_plug_admin()
returns boolean
language sql
stable
security definer
set search_path = ''
as $$
    select exists (
        select 1
        from public.admin_users
        where user_id = (select auth.uid())
    );
$$;

revoke all on function public.is_plug_admin() from public;
grant execute on function public.is_plug_admin() to authenticated;


-- 2. MARKETPLACE CATEGORIES

create table if not exists public.marketplace_categories (
    id uuid primary key default gen_random_uuid(),
    slug text not null unique,
    name text not null,
    description text,
    is_active boolean not null default true,
    created_at timestamptz not null default now()
);

insert into public.marketplace_categories (slug, name)
values
    ('buy-sell', 'Buy & Sell'),
    ('services', 'Services'),
    ('hire', 'Hire'),
    ('taskers', 'Taskers')
on conflict (slug) do nothing;


-- 3. USER ROLES

create table if not exists public.user_roles (
    id uuid primary key default gen_random_uuid(),
    user_id uuid not null references auth.users(id) on delete cascade,
    role text not null check (
        role in (
            'seller',
            'service_provider',
            'equipment_owner',
            'tasker',
            'property_owner'
        )
    ),
    created_at timestamptz not null default now(),
    unique (user_id, role)
);


-- 4. PROVIDER PROFILES

create table if not exists public.provider_profiles (
    id uuid primary key default gen_random_uuid(),
    user_id uuid not null unique references auth.users(id) on delete cascade,
    business_name text not null,
    description text,
    service_area text,
    logo_url text,
    approval_status text not null default 'pending'
        check (approval_status in ('pending', 'approved', 'rejected')),
    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now()
);


-- 5. MARKETPLACE LISTINGS

create table if not exists public.marketplace_listings (
    id uuid primary key default gen_random_uuid(),
    owner_id uuid not null references auth.users(id) on delete cascade,
    category_slug text not null references public.marketplace_categories(slug),
    title text not null,
    description text,
    price numeric(12,2) check (price is null or price >= 0),
    price_type text not null default 'fixed'
        check (price_type in ('fixed', 'negotiable', 'contact')),
    location text,
    photos text[] not null default '{}',
    status text not null default 'pending'
        check (status in (
            'pending', 'approved', 'rejected',
            'suspended', 'sold', 'completed'
        )),
    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now()
);


-- 6. CUSTOMER INQUIRIES
-- Customers contact THE PLUG first.
-- No provider phone numbers are stored here.

create table if not exists public.marketplace_inquiries (
    id uuid primary key default gen_random_uuid(),
    listing_id uuid references public.marketplace_listings(id) on delete set null,
    customer_id uuid references auth.users(id) on delete set null,
    customer_name text not null,
    customer_phone text not null,
    message text not null,
    status text not null default 'new'
        check (status in (
            'new', 'reviewing', 'contacted',
            'negotiating', 'converted', 'closed'
        )),
    created_at timestamptz not null default now()
);


-- 7. TRANSACTION TRACKING
-- Administrators coordinate transaction progress.

create table if not exists public.marketplace_transactions (
    id uuid primary key default gen_random_uuid(),
    inquiry_id uuid unique references public.marketplace_inquiries(id) on delete set null,
    listing_id uuid references public.marketplace_listings(id) on delete set null,
    customer_id uuid references auth.users(id) on delete set null,
    provider_id uuid references auth.users(id) on delete set null,
    status text not null default 'initiated'
        check (status in (
            'initiated', 'verification', 'negotiation',
            'confirmed', 'completed', 'cancelled', 'disputed'
        )),
    created_at timestamptz not null default now(),
    updated_at timestamptz not null default now()
);


-- 8. PRIVATE ADMIN NOTES
-- Separate table so public users cannot read internal notes.

create table if not exists public.marketplace_admin_notes (
    id uuid primary key default gen_random_uuid(),
    entity_type text not null check (
        entity_type in ('listing', 'inquiry', 'transaction', 'report')
    ),
    entity_id uuid not null,
    admin_user_id uuid not null references auth.users(id),
    note text not null,
    created_at timestamptz not null default now()
);


-- 9. USER REPORTS

create table if not exists public.user_reports (
    id uuid primary key default gen_random_uuid(),
    reporter_id uuid references auth.users(id) on delete set null,
    listing_id uuid references public.marketplace_listings(id) on delete set null,
    reason text not null,
    details text,
    status text not null default 'open'
        check (status in (
            'open', 'investigating', 'resolved', 'dismissed'
        )),
    created_at timestamptz not null default now()
);


-- 10. ENABLE ROW LEVEL SECURITY

alter table public.marketplace_categories enable row level security;
alter table public.user_roles enable row level security;
alter table public.provider_profiles enable row level security;
alter table public.marketplace_listings enable row level security;
alter table public.marketplace_inquiries enable row level security;
alter table public.marketplace_transactions enable row level security;
alter table public.marketplace_admin_notes enable row level security;
alter table public.user_reports enable row level security;


-- 11. CATEGORY POLICIES

drop policy if exists "Public view active categories"
on public.marketplace_categories;

create policy "Public view active categories"
on public.marketplace_categories
for select to anon, authenticated
using (is_active = true or public.is_plug_admin());

drop policy if exists "Admins manage categories"
on public.marketplace_categories;

create policy "Admins manage categories"
on public.marketplace_categories
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


-- 12. USER ROLE POLICIES

drop policy if exists "Users view own roles"
on public.user_roles;

create policy "Users view own roles"
on public.user_roles
for select to authenticated
using (user_id = (select auth.uid()) or public.is_plug_admin());

drop policy if exists "Users add own capabilities"
on public.user_roles;

create policy "Users add own capabilities"
on public.user_roles
for insert to authenticated
with check (user_id = (select auth.uid()));

drop policy if exists "Users remove own capabilities"
on public.user_roles;

create policy "Users remove own capabilities"
on public.user_roles
for delete to authenticated
using (user_id = (select auth.uid()) or public.is_plug_admin());


-- 13. PROVIDER PROFILE POLICIES

drop policy if exists "Public view approved providers"
on public.provider_profiles;

create policy "Public view approved providers"
on public.provider_profiles
for select to anon, authenticated
using (
    approval_status = 'approved'
    or user_id = (select auth.uid())
    or public.is_plug_admin()
);

drop policy if exists "Providers create own profile"
on public.provider_profiles;

create policy "Providers create own profile"
on public.provider_profiles
for insert to authenticated
with check (
    user_id = (select auth.uid())
    and approval_status = 'pending'
);

drop policy if exists "Providers update own pending profile"
on public.provider_profiles;

create policy "Providers update own pending profile"
on public.provider_profiles
for update to authenticated
using (
    user_id = (select auth.uid())
    and approval_status = 'pending'
)
with check (
    user_id = (select auth.uid())
    and approval_status = 'pending'
);

drop policy if exists "Admins manage provider profiles"
on public.provider_profiles;

create policy "Admins manage provider profiles"
on public.provider_profiles
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


