drop policy if exists "Owners delete pending listings"
on public.marketplace_listings;

create policy "Owners delete pending listings"
on public.marketplace_listings
for delete to authenticated
using (
    owner_id = (select auth.uid())
    and status = 'pending'
);

drop policy if exists "Admins manage marketplace listings"
on public.marketplace_listings;

create policy "Admins manage marketplace listings"
on public.marketplace_listings
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


-- 15. INQUIRY POLICIES

drop policy if exists "Customers submit inquiries"
on public.marketplace_inquiries;

create policy "Customers submit inquiries"
on public.marketplace_inquiries
for insert to anon, authenticated
with check (
    (customer_id is null or customer_id = (select auth.uid()))
    and status = 'new'
    and (
        listing_id is null
        or exists (
            select 1
            from public.marketplace_listings l
            where l.id = listing_id
            and l.status = 'approved'
        )
    )
);

drop policy if exists "Customers view own inquiries"
on public.marketplace_inquiries;

create policy "Customers view own inquiries"
on public.marketplace_inquiries
for select to authenticated
using (
    customer_id = (select auth.uid())
    or public.is_plug_admin()
);

drop policy if exists "Admins manage inquiries"
on public.marketplace_inquiries;

create policy "Admins manage inquiries"
on public.marketplace_inquiries
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


-- 16. TRANSACTION POLICIES

drop policy if exists "Admins manage transactions"
on public.marketplace_transactions;

create policy "Admins manage transactions"
on public.marketplace_transactions
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


-- 17. PRIVATE ADMIN NOTES POLICIES

drop policy if exists "Admins manage private notes"
on public.marketplace_admin_notes;

create policy "Admins manage private notes"
on public.marketplace_admin_notes
for all to authenticated
using (public.is_plug_admin())
with check (
    public.is_plug_admin()
    and admin_user_id = (select auth.uid())
);


-- 18. REPORT POLICIES

drop policy if exists "Users submit reports"
on public.user_reports;

create policy "Users submit reports"
on public.user_reports
for insert to anon, authenticated
with check (
    (reporter_id is null or reporter_id = (select auth.uid()))
    and status = 'open'
);

drop policy if exists "Reporters view own reports"
on public.user_reports;

create policy "Reporters view own reports"
on public.user_reports
for select to authenticated
using (
    reporter_id = (select auth.uid())
    or public.is_plug_admin()
);

drop policy if exists "Admins manage reports"
on public.user_reports;

create policy "Admins manage reports"
on public.user_reports
for all to authenticated
using (public.is_plug_admin())
with check (public.is_plug_admin());


-- 19. TABLE PERMISSIONS

grant select on public.marketplace_categories to anon, authenticated;
grant all on public.marketplace_categories to authenticated;

grant select, insert, delete on public.user_roles to authenticated;

grant select on public.provider_profiles to anon, authenticated;
grant insert, update on public.provider_profiles to authenticated;

grant select on public.marketplace_listings to anon, authenticated;
grant insert, update, delete on public.marketplace_listings to authenticated;

grant insert (
    listing_id, customer_id, customer_name,
    customer_phone, message
) on public.marketplace_inquiries to anon, authenticated;

grant select, update on public.marketplace_inquiries to authenticated;

grant all on public.marketplace_transactions to authenticated;
grant all on public.marketplace_admin_notes to authenticated;

grant insert (
    reporter_id, listing_id, reason, details
) on public.user_reports to anon, authenticated;

grant select on public.user_reports to authenticated;

